{$CADDY_SITE} {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	@ingest {
		method POST
		path /api/v1/ingest
	}
	handle @ingest {
		request_body {
			max_size 4096
		}
		reverse_proxy app:8080
	}

	handle /healthz {
		reverse_proxy app:8080
	}

	handle {
		basic_auth {
			{$DASHBOARD_USER} {$DASHBOARD_PASSWORD_HASH}
		}
		reverse_proxy app:8080
	}
}
