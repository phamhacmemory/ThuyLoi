{
  "name": "bong-bot-aiot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build web --outDir ../dist --emptyOutDir",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "backup": "node --env-file-if-exists=.env server/backup.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "1.9.22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
